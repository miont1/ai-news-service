# PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aibot_db
DB_HOST=localhost
DB_PORT=5432

DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-nano
