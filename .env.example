# PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aibot_db
DB_HOST=localhost
DB_PORT=5432

DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-nano
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI News Filtering
AI_FILTER_ENABLED=true
AI_FILTER_TOP_K=3

# Telegram (Telethon)
# Obtain API ID and Hash from https://my.telegram.org/apps
TG_API_ID=12345678
TG_API_HASH=your_telegram_api_hash_here
TG_SESSION_NAME=aibot_session
# Optional: Telethon StringSession string if session files cannot be used
# TG_SESSION_STRING=your_string_session_here
# Target Telegram channel for publishing (@channel_username or numeric channel ID -100...)
TG_TARGET_CHANNEL=@your_channel_name


